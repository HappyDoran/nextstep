{
  "name": "@nextstep/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env.local src/main.ts",
    "build": "tsc",
    "start": "node --env-file-if-exists=.env.local dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs tests/prompts/*.test.mjs",
    "verify:naver": "tsx src/verify/naver-imap.ts",
    "verify:jobkorea": "tsx src/verify/jobkorea.ts",
    "verify:saramin": "tsx src/verify/saramin.ts",
    "verify:jumpit": "tsx src/verify/jumpit.ts",
    "verify:wanted": "tsx src/verify/wanted.ts",
    "verify:jasoseol": "tsx src/verify/jasoseol.ts",
    "invite": "tsx src/invite.ts",
    "eval:recommend": "tsx --env-file-if-exists=.env.local src/verify/eval-recommend.ts",
    "verify:mail-accuracy": "tsx src/verify/mail-accuracy.ts",
    "verify:mail-sync": "tsx --env-file-if-exists=.env.local src/verify/mail-sync.ts",
    "verify:recommend-flow": "tsx --env-file-if-exists=.env.local src/verify/recommend-flow.ts"
  },
  "dependencies": {
    "@nextstep/contracts": "workspace:*",
    "fastify": "5.12.8",
    "imapflow": "2.9.1",
    "pdfjs-dist": "6.4.299",
    "zod": "catalog:"
  },
  "devDependencies": {
    "tsx": "^4.21.0"
  }
}
