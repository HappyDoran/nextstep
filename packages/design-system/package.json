{
  "name": "@nextstep/design-system",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tokens.css": "./src/tokens.css",
    "./primitives.css": "./src/primitives.css",
    "./styles.css": "./src/styles.css",
